{
    "manifest_version": 3,
    "name": "URL Safety Detector",
    "version": "1.0",
    "description": "Automatically checks if a website is safe or malicious",

    "permissions": [
        "tabs",
        "activeTab",
        "webNavigation"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],

    "action": {
        "default_title": "URL Safety Detector"
    }
}
